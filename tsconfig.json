{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@screen/*": ["src/screen/*"],
      "@hooks/*": ["src/hooks/*"],
      "@model/*": ["src/model/*"],
      "@context/*": ["src/context/*"],
      "@utils/*": ["src/utils/*"],
      "@assets/*": ["src/assets/*"],
      "@navigation/*": ["src/navigation/*"],
      "@notification/*": ["src/notification/*"],
      "@reducers/*": ["src/reducers/*"],
      "@IAM/*": ["src/IAM/*"]
    }
  }
}
